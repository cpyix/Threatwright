{
  "$id": "question.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "addressee": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Addressee"
    },
    "answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer"
    },
    "custom": {
      "additionalProperties": true,
      "default": {},
      "title": "Custom",
      "type": "object"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_]*-[0-9]{4,}$",
      "title": "Id",
      "type": "string"
    },
    "library_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Library Ref"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "short_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Short Name"
    },
    "status": {
      "default": "open",
      "enum": [
        "open",
        "answered"
      ],
      "title": "Status",
      "type": "string"
    },
    "threats": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*-[0-9]{4,}$",
        "type": "string"
      },
      "title": "Threats",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "uuid": {
      "format": "uuid",
      "title": "Uuid",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "title": "Question",
  "type": "object"
}
