# Threatwright pipeline for GitLab CI (generated by `threatwright ci gitlab`).
# Models: [[ models | join(", ") if models else "all models of the project" ]]
# Documents: [% for t, formats in documents.items() %][[ t ]] ([[ formats | join(", ") ]])[% if not loop.last %], [% endif %][% endfor %]


# The pipeline needs no network access besides pulling the image.
# Merge requests: validation as JUnit test report. Default branch and tags: documents as
# job artifacts. Tags: change evidence against the previous tag.

variables:
  TW_PROJECT: [[ project_path | yaml_str ]]
  GIT_DEPTH: "0"  # full history, needed for the diff against the previous tag

default:
  image:
    name: [[ image ]]
    entrypoint: [""]

stages:
  - validate
  - build

threatwright-validate:
  stage: validate
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
    - if: $CI_COMMIT_TAG
  script:
    - cd "$TW_PROJECT"
    - threatwright validate . --strict --format junit -o "$CI_PROJECT_DIR/report.xml"
  artifacts:
    when: always
    reports:
      junit: report.xml

threatwright-build:
  stage: build
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
    - if: $CI_COMMIT_TAG
  script:
    - cd "$TW_PROJECT"
[% for t, formats in documents.items() %]
    - threatwright build . --template [[ t ]][% for f in formats %] --format [[ f ]][% endfor %] -o "$CI_PROJECT_DIR/threatwright-out"
[% endfor %]
  artifacts:
    name: "threatwright-$CI_COMMIT_REF_SLUG"
    paths:
      - threatwright-out/

threatwright-diff:
  stage: build
  rules:
    - if: $CI_COMMIT_TAG
  script:
    - git config --global --add safe.directory "$CI_PROJECT_DIR"
    - cd "$TW_PROJECT"
    - PREV="$(git describe --tags --abbrev=0 "$CI_COMMIT_TAG^" 2>/dev/null || true)"
    - |
      if [ -z "$PREV" ]; then
        echo "No previous tag: $CI_COMMIT_TAG is the first release." > "$CI_PROJECT_DIR/change-evidence.md"
      else
        threatwright diff "$PREV" "$CI_COMMIT_TAG" --format md -o "$CI_PROJECT_DIR/change-evidence.md"
      fi
  artifacts:
    name: "change-evidence-$CI_COMMIT_TAG"
    paths:
      - change-evidence.md
