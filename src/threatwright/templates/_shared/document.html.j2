{#- Generic self-contained HTML document (also the GUI preview): no external resources.
    Use it with {% extends "document.html.j2" %} and override `style` or `content`. -#}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{ document.generator }}">
<title>{{ document.title }}</title>
<style>
{% block style %}
:root { --ink: #1f2933; --muted: #52606d; --line: #cbd2d9; --head: #e4e7eb; --note: #fff8e1; --accent: #243b53; }
body { font-family: "Segoe UI", "Liberation Sans", Arial, sans-serif; color: var(--ink); max-width: 60rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.45; font-size: 15px; }
h1.doc-title { font-size: 2rem; color: var(--accent); margin: 2rem 0 .25rem; }
p.subtitle { font-size: 1.15rem; color: var(--muted); margin-top: 0; }
h2 { color: var(--accent); border-bottom: 2px solid var(--accent); padding-bottom: .2rem; margin-top: 2.2rem; }
h3 { color: var(--accent); margin-top: 1.6rem; }
table { border-collapse: collapse; width: 100%; margin: .6rem 0 1rem; font-size: .9rem; }
th, td { border: 1px solid var(--line); padding: .3rem .45rem; text-align: left; vertical-align: top; }
th { background: var(--head); }
table.fields td:first-child { font-weight: 600; width: 30%; background: #f5f7fa; }
.note { background: var(--note); border-left: 4px solid #f0b429; padding: .5rem .75rem; }
footer { color: var(--muted); font-size: .8rem; border-top: 1px solid var(--line); margin-top: 3rem; padding-top: .5rem; }
@media print { .pagebreak { break-after: page; } body { margin: 0; max-width: none; } }
{% endblock %}
</style>
</head>
<body>
{% block content %}
{% for s in outline %}
<section class="section-{{ s.type }}">
{% for b in s.blocks %}
{% if b.kind == "title" %}
<h1 class="doc-title">{{ b.text }}</h1>
{% elif b.kind == "subtitle" %}
<p class="subtitle">{{ b.text }}</p>
{% elif b.kind == "h1" %}
<h2>{{ b.text }}</h2>
{% elif b.kind == "h2" %}
<h3>{{ b.text }}</h3>
{% elif b.kind == "p" %}
<p>{{ b.text }}</p>
{% elif b.kind == "note" %}
<p class="note"><strong>{{ t("note") }}:</strong> {{ b.text }}</p>
{% elif b.kind == "table" %}
<table>
<thead><tr>{% for h in b.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
<tbody>
{% for r in b.rows %}
<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>
{% endfor %}
</tbody>
</table>
{% elif b.kind == "fields" %}
<table class="fields">
{% for r in b.rows %}
<tr><td>{{ r[0] }}</td><td>{{ r[1] }}</td></tr>
{% endfor %}
</table>
{% elif b.kind == "pagebreak" %}
<div class="pagebreak"></div>
{% endif %}
{% endfor %}
</section>
{% endfor %}
{% endblock %}
<footer>{{ document.generator }} · {{ document.title }} · {{ t("version") }} {{ document.version or "–" }} · {{ document.date|date }}</footer>
</body>
</html>
