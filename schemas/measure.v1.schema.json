{
  "$defs": {
    "OscalRef": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Id"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "uuid": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uuid"
        }
      },
      "required": [
        "source"
      ],
      "title": "OscalRef",
      "type": "object"
    }
  },
  "$id": "measure.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compensating": {
      "default": false,
      "title": "Compensating",
      "type": "boolean"
    },
    "cra_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Cra Refs",
      "type": "array"
    },
    "custom": {
      "additionalProperties": true,
      "default": {},
      "title": "Custom",
      "type": "object"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "due": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due"
    },
    "evidence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_]*-[0-9]{4,}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "technical",
            "organizational",
            "design",
            "user_information",
            "supply_chain"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kind"
    },
    "library_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Library Ref"
    },
    "oscal_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/OscalRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "short_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Short Name"
    },
    "status": {
      "default": "proposed",
      "enum": [
        "proposed",
        "decided",
        "in_progress",
        "implemented"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "uuid": {
      "format": "uuid",
      "title": "Uuid",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "title": "Measure",
  "type": "object"
}
