    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_]*-[0-9]{4,}$",
      "title": "Id",
      "type": "string"
    },
    "library_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
