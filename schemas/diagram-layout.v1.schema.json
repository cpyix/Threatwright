{
  "$defs": {
    "DiagramNote": {
      "additionalProperties": false,
      "description": "Free text on the diagram canvas (annotation, not part of the threat model).",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "text"
      ],
      "title": "DiagramNote",
      "type": "object"
    },
    "NodeLayout": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "NodeLayout",
      "type": "object"
    }
  },
  "$id": "diagram-layout.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content of diagram.layout.yaml: positions and canvas notes, never model content.",
  "properties": {
    "nodes": {
      "additionalProperties": {
        "$ref": "#/$defs/NodeLayout"
      },
      "default": {},
      "title": "Nodes",
      "type": "object"
    },
    "notes": {
      "additionalProperties": {
        "$ref": "#/$defs/DiagramNote"
      },
      "default": {},
      "title": "Notes",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "DiagramLayout",
  "type": "object"
}
