{
  "$id": "project.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archived": {
      "default": false,
      "title": "Archived",
      "type": "boolean"
    },
    "language": {
      "default": "de",
      "enum": [
        "de",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
    "libraries": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Libraries",
      "type": "array"
    },
    "lifecycle": {
      "default": "development",
      "enum": [
        "development",
        "post_market"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "method": {
      "default": "tr-03183-1",
      "title": "Method",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "next_review": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Review"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "support_until": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Support Until"
    },
    "templates": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Templates",
      "type": "array"
    },
    "uuid": {
      "format": "uuid",
      "title": "Uuid",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "ProjectConfig",
  "type": "object"
}
