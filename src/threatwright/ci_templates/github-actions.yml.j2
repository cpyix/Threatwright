# Threatwright workflow for GitHub Actions (generated by `threatwright ci github`).
# Save as .github/workflows/threatwright.yml.
# Models: [[ models | join(", ") if models else "all models of the project" ]]
# Documents: [% for t, formats in documents.items() %][[ t ]] ([[ formats | join(", ") ]])[% if not loop.last %], [% endif %][% endfor %]


# The jobs need no network access besides pulling the image and the two pinned actions.
# Pull requests: validation (JUnit report as artifact). Default branch and tags: documents
# as artifacts. Tags: change evidence against the previous tag.

name: threatwright

on:
  pull_request:
  push:

permissions:
  contents: read

env:
  TW_PROJECT: [[ project_path | yaml_str ]]

jobs:
  validate:
    if: >-
      github.event_name == 'pull_request' || github.ref_type == 'tag' ||
      github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-latest
    container:
      image: [[ image ]]
      options: --user 0  # actions/checkout needs to write the workspace
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Validate
        run: |
          cd "$TW_PROJECT"
          threatwright validate . --strict --format junit -o "$GITHUB_WORKSPACE/report.xml"
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        if: always()
        with:
          name: validation-report
          path: report.xml

  build:
    needs: validate
    if: >-
      github.event_name == 'push' && (github.ref_type == 'tag' ||
      github.ref == format('refs/heads/{0}', github.event.repository.default_branch))
    runs-on: ubuntu-latest
    container:
      image: [[ image ]]
      options: --user 0
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Build documents
        run: |
          cd "$TW_PROJECT"
[% for t, formats in documents.items() %]
          threatwright build . --template [[ t ]][% for f in formats %] --format [[ f ]][% endfor %] -o "$GITHUB_WORKSPACE/threatwright-out"
[% endfor %]
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: threatwright-${{ github.ref_name }}
          path: threatwright-out/

  diff:
    needs: validate
    if: github.event_name == 'push' && github.ref_type == 'tag'
    runs-on: ubuntu-latest
    container:
      image: [[ image ]]
      options: --user 0
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0  # full history, needed for the diff against the previous tag
          persist-credentials: false
      - name: Change evidence
        run: |
          git config --global --add safe.directory "$GITHUB_WORKSPACE"
          cd "$TW_PROJECT"
          PREV="$(git describe --tags --abbrev=0 "$GITHUB_REF_NAME^" 2>/dev/null || true)"
          if [ -z "$PREV" ]; then
            echo "No previous tag: $GITHUB_REF_NAME is the first release." > "$GITHUB_WORKSPACE/change-evidence.md"
          else
            threatwright diff "$PREV" "$GITHUB_REF_NAME" --format md -o "$GITHUB_WORKSPACE/change-evidence.md"
          fi
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: change-evidence-${{ github.ref_name }}
          path: change-evidence.md
